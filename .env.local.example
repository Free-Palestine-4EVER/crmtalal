# ============================================================
# Edarah Platform — Environment
# Copy to .env.local and fill in. Restart `pnpm dev` after edits.
# ============================================================

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Firebase Web SDK (client) ----
# Firebase console → Project settings → General → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server) ----
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either paste the whole JSON on one line as FIREBASE_SERVICE_ACCOUNT ...
FIREBASE_SERVICE_ACCOUNT=
# ... or provide the three fields individually (escape newlines in the key as \n):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Emails that are auto-promoted to admin on registration (comma-separated).
ADMIN_BOOTSTRAP_EMAILS=

# ---- OneSignal (Web Push) ----
# OneSignal dashboard → Settings → Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
